   "source": [
    "## Get the number of days from metadata variable which will be used to get data from IMDIWrongedReads\n",
    "entity = classControlEntity(int(entityId))\n",
    "try: \n",
    "  varWrongedDateConfig = entity.getMetadataValue(\"varWrongedDateConfig\")\n",
    "  varWrongedDateConfig = int(varWrongedDateConfig)\n",
    "except:\n",
    "  varWrongedDateConfig = \"\"\n",
    "\n",
    "deltaDateTime = dataset.getDeltaDate()\n",
    "## Future date to update personalloaddate in relationship data\n",
    "futureDate = (datetime.now() + relativedelta(days=1)).strftime(\"%Y-%m-%d 00:00:00\")\n",
    "## IMDIWrongedDateStart to get the data from IMDIWrongedreads\n",
    "IMDIWrongedDateStart = (datetime.now() - relativedelta(days=varWrongedDateConfig)).strftime(\"%Y-%m-%d 00:00:00\") \n",
    "notodyasetEarliestStartDate = (datetime.now() - relativedelta(months=25)).strftime(\"%Y-%m-%d\")\n",
    "notodyasetEarliestStartDateSid = (datetime.now() - relativedelta(months=25)).strftime(\"%Y%m%d\")\n",
    "notodyasetEarliestStartYYYYMMSid = (datetime.now() - relativedelta(months=25)).strftime(\"%Y%m\")\n",
    "personalMetadataLoadYearDelta = (datetime.now() - relativedelta(months=25)).strftime(\"%Y\")\n",
    "personalMetadataLoadMonthDelta = (datetime.now() - relativedelta(months=25)).strftime(\"%m\")\n",
    "\n",
    "targetExists = dataset.targetExists\n",
    "\n",
    "print(f\"varWrongedDateConfig: {varWrongedDateConfig}\")\n",
    "print(f\"deltaDateTime: {deltaDateTime}\")\n",
    "print(f\"futureDate: {futureDate}\")\n",
    "print(f\"notodyasetEarliestStartDate: {notodyasetEarliestStartDate}\")\n",
    "print(f\"notodyasetEarliestStartDate: {notodyasetEarliestStartDate}\")\n",
    "print(f\"notodyasetEarliestStartDateSid: {notodyasetEarliestStartDateSid}\")\n",
    "print(f\"notodyasetEarliestStartYYYYMMSid: {notodyasetEarliestStartYYYYMMSid}\")\n",
    "print(f\"personalMetadataLoadYearDelta: {personalMetadataLoadYearDelta}\")\n",
    "print(f\"personalMetadataLoadMonthDelta: {personalMetadataLoadMonthDelta}\")\n",
    "print(f\"targetExists: {targetExists}\")"
   ]
