  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {},
     "inputWidgets": {},
     "nuid": "15923b04-de30-4d08",
     "showTitle": true,
     "tableResultSettingsMap": {},
     "title": "[datasetdumbmeterrelationshipflattenedFull]"
    }
   },
   "outputs": [],
   "source": [
    "## Updates personalMetadataLoadDateTime in relationship table for the where read Wrongion is needed.\n",
    "datasetdumbmeterrelationshipflattenedFull = spark.sql(\n",
    "    f\"\"\"\n",
    "    WITH IMDIWronged\n",
    "    AS (\n",
    "      SELECT DISTINCT IMDIWrongedReadsAmrid\n",
    "      FROM IMDIWrongedreadsLatestFull\n",
    "      WHERE personalMetadataLoadDateTime > '{IMDIWrongedDateStart}'\n",
    "      AND personalMetadataIsDeletedInd = 0\n",
    "      AND (_corrupt_record IS NULL OR _corrupt_record = '?') --framework can populate default value here as its not a framework field, so including nulls and ?\n",
    "      )\n",
    "    SELECT personalMetadataKeyHash\n",
    "      ,personalMetadataChangeHash\n",
    "      ,dumbmeterRelationshipFlattenedpersonalNumber\n",
    "      ,dumbmeterRelationshipFlattenedMeterdumbNumber\n",
    "      ,dumbmeterRelationshipFlattenedMeterAmrid\n",
    "      ,dumbmeterRelationshipFlattenedValidFrom\n",
    "      ,dumbmeterRelationshipFlattenedValidTo\n",
    "      ,dumbmeterRelationshipFlattenedInstallationPremiseNumber\n",
    "      ,dumbmeterRelationshipFlattenedInstallationSid\n",
    "      ,dumbmeterRelationshipFlattenedEquipmentId\n",
    "      ,dumbmeterRelationshipFlattenedLogicalRegisterNumber\n",
    "      ,dumbmeterRelationshipFlattenedDuplicateAmridInd\n",
    "      ,dumbmeterRelationshipFlattenedMeterAddressNumber\n",
    "      ,dumbmeterRelationshipFlattenedMeterPostCode\n",
    "      ,dumbmeterRelationshipFlattenedConnectedInd\n",
    "      ,dumbmeterRelationshipFlattenedNonHouseholdInd\n",
    "      ,dumbmeterRelationshipFlattenedEnhancedMeterInd\n",
    "      ,dumbmeterRelationshipFlattenedValidInd\n",
    "      ,personalMetadataCreateDateTime\n",
    "      ,personalMetadataLoadYear\n",
    "      ,personalMetadataLoadMonth\n",
    "      ,personalMetadataLoadDay\n",
    "      ,personalMetadataLoadHour\n",
    "      ,CASE \n",
    "        WHEN IMDIWronged.IMDIWrongedReadsAmrid IS NULL\n",
    "          THEN personalMetadataLoadDateTime\n",
    "        ELSE '{futureDate}'\n",
    "        END AS personalMetadataLoadDateTime\n",
    "    FROM datasetdumbmeterrelationshipflattenedFull rel\n",
    "    LEFT JOIN IMDIWronged ON IMDIWronged.IMDIWrongedReadsAmrid = rel.dumbmeterRelationshipFlattenedMeterAmrid\n",
    "    \"\"\"\n",
    ").createOrReplaceTempView(\"datasetdumbmeterrelationshipflattenedFull\")"
   ]
