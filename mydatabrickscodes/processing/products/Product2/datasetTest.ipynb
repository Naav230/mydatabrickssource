   "outputs": [],
   "source": [
    "if targetExists:\n",
    "\n",
   
    "    base1 = spark.sql(\n",
    "        f\"\"\"\n",
    "        SELECT dumbmeterCleansedRelationshipKeyHash\n",
    "            ,dumbmeterCleansedMeterReadAmrid\n",
    "            ,dumbmeterCleansedMeterReadRecordTime\n",
    "            ,dumbmeterCleansedMeterReadRecordDateSid\n",
    "            ,dumbmeterCleansedMeterReadRecordDateYYYYMMSid\n",
    "            ,dumbmeterCleansedMeterReading\n",
    "            ,CASE \n",
    "                WHEN dumbmeterCleansedMeterReadisValidInd = 1\n",
    "                    AND dumbmeterCleansedMeterReading < dumbmeterCleansedMeterReadingAsc\n",
    "                    THEN 0\n",
    "                ELSE dumbmeterCleansedMeterReadisValidInd\n",
    "                END AS dumbmeterCleansedMeterReadisValidInd\n",
    "        FROM records\n",
    "        WHERE updateTarget = 1\n",
    "            AND dumbmeterCleansedMeterReadRecordDateSid >= {notodyasetEarliestStartDateSid}\n",
    "        \"\"\"\n",
    "    )\n",
    "\n",
    "    base2 = base1.union(invalidateRecordsBeyondValidTo)\n",
    "\n",
    "    baseJoinedPrep = base2.union(invalidateInvalidRelationship)\n",
    "\n",
    "else:\n",
    "    baseJoinedPrep = spark.sql(\n",
    "        f\"\"\"\n",
    "        SELECT dumbmeterCleansedRelationshipKeyHash\n",
    "            ,dumbmeterCleansedMeterReadAmrid\n",
    "            ,dumbmeterCleansedMeterReadRecordTime\n",
    "            ,dumbmeterCleansedMeterReadRecordDateSid\n",
    "            ,dumbmeterCleansedMeterReadRecordDateYYYYMMSid\n",
    "            ,dumbmeterCleansedMeterReading\n",
    "            ,dumbmeterCleansedMeterReadisValidInd\n",
    "        FROM validRecords\n",
    "        WHERE dumbmeterCleansedMeterReadisValidInd = 1\n",
    "        \"\"\"\n",
    "    )"
   ]
