  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {},
     "inputWidgets": {},
     "nuid": "96254feb2e24",
     "showTitle": true,
     "tableResultSettingsMap": {},
     "title": "[otdumbmeterReadsLatestFull]"
    }
   },
   "outputs": [],
   "source": [
    "## Logic to Replace Bad Meter Reads from IMDIWrongedreadsLatestFull.\n",
    "## Not entireone cell\n",
    "\n",
    "sql = \"\"\"\n",
    "      SELECT\n",
    "        org.personalMetadataKeyHash,\n",
    "        org.personalMetadataChangeHash,\n",
    "        org.ID,\n",
    "        org.AMRID,CASE\n",
    "          WHEN (\n",
    "            (new.IMDIWrongedReadsMeterRepID IS NOT NULL)\n",
    "            AND (new.IMDIWrongedReadsMeterRepID <> '?')\n",
    "          ) THEN new.IMDIWrongedReadsMeterRepID\n",
    "          ELSE org.REPID\n",
    "        END AS REPID,\n",
    "        org.RecordTime,\n",
    "        org.ReceivedDateTime,CASE\n",
    "          WHEN (new.IMDIWrongedReadsMeterReading IS NOT NULL) THEN new.IMDIWrongedReadsMeterReading\n",
    "          ELSE org.MeterReading\n",
    "        END AS MeterReading,\n",
    "        org.personalMetadataSourceFileName,\n",
    "        org.personalMetadataIsDeletedInd,\n",
    "        org.personalMetadataLoadYear,\n",
    "        org.personalMetadataLoadMonth,\n",
    "        org.personalMetadataLoadDay,\n",
    "        org.personalMetadataLoadHour,\n",
    "        org.personalMetadataLoadDateTime,\n",
    "        org.personalMetadataCreateDateTime\n",
    "      FROM\n",
    "        otdumbmeterReadsLatestFull org\n",
    "        LEFT JOIN IMDIWrongedreadsLatestFull new ON org.AMRID = new.IMDIWrongedReadsAmrid\n",
    "        AND org.RecordTime = new.IMDIWrongedReadsRecordTime\n",
    "        AND new.personalMetadataIsDeletedInd = 0\n",
    "        AND (new._corrupt_record IS NULL OR new._corrupt_record = '?') -- default value here as its not a field, so including nulls and ?\n",
    "      \"\"\"\n",
    "try:\n",
    "    otdumbmeterReadsLatestFull = spark.sql(sql + \" WHERE MINUTE(org.recordTime) = 0\")\n",
    "except:\n",
    "    otdumbmeterReadsLatestFull = spark.sql(sql)\n",
    "\n",
    "otdumbmeterReadsLatestFull.createOrReplaceTempView(\"otdumbmeterReadsLatestFull\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {},
     "inputWidgets": {},
     "nuid": "81a5edd444e08e",
     "showTitle": true,
     "tableResultSettingsMap": {},
     "title": "[validpersonals]"
    }
   },
   "outputs": [],
   "source": [
    "## used downstream: relationshipDeltaDate, personalDeltaDate, consentFlag, dumbmeterRelationshipFlattenedConnectedInd\n",
    "\n",
    "validpersonals = spark.sql(\n",
    "    f\"\"\"\n",
    "    SELECT r.personalMetadataKeyHash AS relationshipKeyHash\n",
    "      ,r.dumbmeterRelationshipFlattenedMeterAmrid AS relationshipAmrid\n",
    "      --,r.personalMetadataLoadDateTime AS relationshipDeltaDate\n",
    "      --,ca.personalMetadataLoadDateTime AS personalDeltaDate\n",
    "      ,CASE \n",
    "        WHEN ca.personal = '?'\n",
    "          THEN CAST('9999-12-31' AS TIMESTAMP)\n",
    "        WHEN ca.personaldumbmeterHourlyReadConsentId IN (\n",
    "            \"20\"\n",
    "            ,\"30\"\n",
    "            ,\"40\"\n",
    "            )\n",
    "          THEN CAST(ca.personaldumbmeterHourlyReadConsentDate AS TIMESTAMP)\n",
    "        ELSE CAST('9999-12-31' AS TIMESTAMP)\n",
    "        END AS hourlyConsentValidFrom\n",
    "      ,r.dumbmeterRelationshipFlattenedValidFrom\n",
    "      ,personal_{env}.function.dateToSid(r.dumbmeterRelationshipFlattenedValidFrom) AS dumbmeterRelationshipFlattenedValidFromSid\n",
    "      ,r.dumbmeterRelationshipFlattenedValidTo\n",
    "      ,personal_{env}.function.dateToSid(r.dumbmeterRelationshipFlattenedValidTo) AS dumbmeterRelationshipFlattenedValidToSid\n",
    "      -- ,CASE \n",
    "      --   WHEN ca.personaldumbmeterHourlyReadConsentId IN (\n",
    "      --       \"20\"\n",
    "      --       ,\"30\"\n",
    "      --       ,\"40\"\n",
    "      --       )\n",
    "      --     AND year(ca.personaldumbmeterHourlyReadConsentDate) <> 9999\n",
    "      --     THEN \"Y\" -- IS CONSENTED\n",
    "      --   ELSE \"N\"\n",
    "      --   END AS consentFlag\n",
    "      ,r.personalmetadataloaddatetime AS personalmetadataloaddatetime\n",
    "      ,r.dumbmeterRelationshipFlattenedValidInd\n",
    "      ,r.dumbmeterRelationshipFlattenedDuplicateAmridInd\n",
    "      --,r.dumbmeterRelationshipFlattenedConnectedInd\n",
    "    FROM datasetdumbmeterRelationshipFlattenedFull r\n",
    "    INNER JOIN dimpersonalFull ca ON r.dumbmeterRelationshipFlattenedpersonalNumber = ca.personal\n",
    "      AND r.dumbmeterRelationshipFlattenedValidInd = 1\n",
    "    \"\"\"\n",
    ")\n",
    "\n",
    "validpersonals.persist()\n",
    "validpersonals.createOrReplaceTempView(\"validpersonals\")"
   ]
  },
  {
   "cell_type": "code",
